# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copia este archivo como .env y completa los valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://bnxkxkhjmsjrxiuylgpv.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# JWT — Genera un secreto fuerte: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# CORS — Orígenes permitidos separados por coma (sin espacios)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Drive (opcional — si está vacío, las fotos se guardan localmente)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
